#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
find .specify -type f -name '*.json' -print0 | xargs -0 -r jq empty
find .specify/scripts/bash -type f -name '*.sh' -print0 | xargs -0 -r -n1 bash -n
if command -v specify >/dev/null 2>&1; then
  specify integration status >/dev/null
fi
actionlint
zizmor --offline --min-severity medium --min-confidence medium .github
